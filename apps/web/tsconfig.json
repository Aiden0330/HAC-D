{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "paths": {
      "@hac-d/core": [
        "../../packages/core/src/index.ts"
      ],
      "@hac-d/core/library.json": [
        "../../packages/core/data/library.json"
      ],
      "@hac-d/importers": [
        "../../packages/importers/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts"
  ]
}
